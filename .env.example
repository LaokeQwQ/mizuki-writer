# 管理后台监听地址和端口（默认仅本机访问）
HOST=127.0.0.1
PORT=7021
# true trusts one reverse proxy; a positive integer trusts that many proxy hops
TRUST_PROXY=false
CORS_ORIGIN=
# 仅在 HTTPS 反向代理已经正确配置后启用
ENABLE_HSTS=false

# JWT 密钥（生产环境必须显式配置）
JWT_SECRET=

# 管理员用户名（默认 admin）
ADMIN_USERNAME=admin

# 可选：迁移旧的单管理员配置时使用；常规首次初始化请留空
ADMIN_PASSWORD_HASH=

# Mizuki 博客项目根目录（绝对路径）
# 示例: /home/user/mizuki
BLOG_DIR=

# Twikoo 评论服务地址
# 示例: https://twikoo.your-domain.com
TWIKOO_URL=

# 仅在本地开发明确需要 HTTP 服务时设置为 true
ALLOW_INSECURE_TWIKOO=false

# Twikoo 管理密码（你在 Twikoo 后台设置的密码）
TWIKOO_PASSWORD=

# 博客站点 URL（用于 CDN 刷新/预热）
# 示例: https://blog.your-domain.com
SITE_URL=
ALLOW_INSECURE_SITE_URL=false

# 多吉云 AccessKey & SecretKey（用于 CDN 刷新/预热）
# 在 https://console.dogecloud.com/user/keys 获取
DOGECLOUD_ACCESS_KEY=
DOGECLOUD_SECRET_KEY=

# PostgreSQL 数据库连接
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=mizuki_admin
PG_USER=
PG_PASSWORD=
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
