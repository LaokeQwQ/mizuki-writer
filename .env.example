# 管理后台端口
PORT=7021

# JWT 密钥（首次启动会自动生成）
JWT_SECRET=

# 管理员用户名（默认 admin）
ADMIN_USERNAME=admin

# 管理员密码哈希（首次通过 setup 页面设置，自动写入）
ADMIN_PASSWORD_HASH=

# Mizuki 博客项目根目录（绝对路径）
# 示例: /home/user/mizuki
BLOG_DIR=

# Twikoo 评论服务地址
# 示例: https://twikoo.your-domain.com
TWIKOO_URL=

# Twikoo 管理密码（你在 Twikoo 后台设置的密码）
TWIKOO_PASSWORD=

# 博客站点 URL（用于 CDN 刷新/预热）
# 示例: https://blog.your-domain.com
SITE_URL=

# 多吉云 AccessKey & SecretKey（用于 CDN 刷新/预热）
# 在 https://console.dogecloud.com/user/keys 获取
DOGECLOUD_ACCESS_KEY=
DOGECLOUD_SECRET_KEY=

# PostgreSQL 数据库连接
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=mizuki_admin
PG_USER=
PG_PASSWORD=
